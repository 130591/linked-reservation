<!DOCTYPE html>
<html>

<body style="font-family: sans-serif; max-width: 600px; margin: 0 auto;">

  <h2>Reserva Confirmada ✅</h2>
  <p>Olá, <strong>{{name recipient.name}}</strong>!</p>
  <p>Sua reserva no <strong>{{hotel.name}}</strong> foi confirmada.</p>

  <table style="width:100%; border-collapse: collapse; margin: 24px 0;">
    <tr style="background: #f5f5f5;">
      <td style="padding: 12px;">Check-in</td>
      <td style="padding: 12px;">{{formatDate checkIn "DD/MM/YYYY"}}</td>
    </tr>
    <tr>
      <td style="padding: 12px;">Check-out</td>
      <td style="padding: 12px;">{{formatDate checkOut "DD/MM/YYYY"}}</td>
    </tr>
    <tr style="background: #f5f5f5;">
      <td style="padding: 12px;">Quarto</td>
      <td style="padding: 12px;">{{room.name}}</td>
    </tr>
    <tr>
      <td style="padding: 12px;">Hóspedes</td>
      <td style="padding: 12px;">{{guests}}</td>
    </tr>
  </table>

  {{#if rooms}}
  <h3>Quartos disponíveis</h3>
  <ul>
    {{#each rooms}}
    <li>{{this.name}} — capacidade: {{this.capacity}} hóspedes</li>
    {{/each}}
  </ul>
  {{/if}}

  {{#if bookingLink}}
  <a href="{{bookingLink}}"
    style="display:inline-block; padding: 12px 24px; background:#2563eb; color:#fff; border-radius:6px; text-decoration:none;">
    Acessar reserva
  </a>
  {{/if}}

</body>

</html>