{{! templates/reservation.reminder/email.hbs }}
<!DOCTYPE html>
<html>

<body style="font-family:sans-serif; max-width:600px; margin:0 auto; color:#1a1a1a;">

  <div style="background:#2563eb; padding:32px; text-align:center;">
    <h1 style="color:#fff; margin:0;">Sua estadia está chegando!</h1>
  </div>

  <div style="padding:32px;">
    <p>Olá, <strong>{{name customerName}}</strong>!</p>
    <p>Este é um lembrete da sua reserva em <strong>{{hotelName}}</strong>.</p>

    <table style="width:100%; border-collapse:collapse; margin:24px 0;">
      <tr style="background:#f8fafc;">
        <td style="padding:12px; border:1px solid #e2e8f0;">Check-in</td>
        <td style="padding:12px; border:1px solid #e2e8f0;">
          <strong>{{formatDate checkIn "DD/MM/YYYY"}}</strong>
        </td>
      </tr>
      <tr>
        <td style="padding:12px; border:1px solid #e2e8f0;">Check-out</td>
        <td style="padding:12px; border:1px solid #e2e8f0;">
          <strong>{{formatDate checkOut "DD/MM/YYYY"}}</strong>
        </td>
      </tr>
      <tr style="background:#f8fafc;">
        <td style="padding:12px; border:1px solid #e2e8f0;">Quarto</td>
        <td style="padding:12px; border:1px solid #e2e8f0;">{{roomName}}</td>
      </tr>
      <tr>
        <td style="padding:12px; border:1px solid #e2e8f0;">Hóspedes</td>
        <td style="padding:12px; border:1px solid #e2e8f0;">{{guests}}</td>
      </tr>
    </table>

    {{#if bookingLink}}
    <div style="text-align:center; margin:32px 0;">
      <a href="{{bookingLink}}" style="background:#2563eb; color:#fff; padding:14px 28px;
                border-radius:6px; text-decoration:none; font-weight:bold;">
        Ver reserva
      </a>
    </div>
    {{/if}}

    <p style="color:#64748b; font-size:14px;">
      Qualquer dúvida, entre em contato conosco. Até breve! 🏨
    </p>
  </div>

</body>

</html>